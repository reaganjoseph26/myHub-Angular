{
  "name": "myhub-angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start":  "concurrently \"npm run build:ssr:watch\" \"npm run server:watch\"",
    "build:ssr:watch": "ng build --watch",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node server/server.js",
    "server:watch": "nodemon server/server.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0",
    "vanta": "^0.5.24",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.3",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/three": "^0.185.4",
    "concurrently": "^10.0.5",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2",
    "wait-on": "^9.1.0"
